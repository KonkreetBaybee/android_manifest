<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remotes -->
  <remote name="aosp" fetch="https://android.googlesource.com/" />
  <remote name="lineage" fetch="https://github.com/LineageOS/" />
  <remote name="pixelbuilds" fetch="https://github.com/PixelBuildsROM/" />

  <!-- Default revision (Android 16 base) -->
  <default revision="refs/tags/android-16.0.0_r1"
           remote="aosp"
           sync-j="4"/>

  <!-- Build System -->
  <project path="build/make"
           name="android_build"
           remote="lineage"
           revision="lineage-23.0"/>
  <project path="build/soong"
           name="android_build_soong"
           remote="lineage"
           revision="lineage-23.0"/>
  <project path="build/kati"
           name="android_build_kati"
           remote="lineage"
           revision="lineage-23.0"/>
  <project path="build/blueprint"
           name="android_build_blueprint"
           remote="lineage"
           revision="lineage-23.0"/>

  <!-- Snippets -->
  <include name="snippets/lineage.xml" />
  <include name="snippets/pixelbuilds.xml" />
  <include name="snippets/theme.xml" />
  <include name="snippets/tools.xml" />
</manifest>

